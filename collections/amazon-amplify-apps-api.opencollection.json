{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon Amplify REST Apps API",
    "version": "2017-07-25"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
