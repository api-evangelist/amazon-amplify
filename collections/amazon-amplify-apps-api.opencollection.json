        {
          "info": {
            "name": "Amazon Amplify Create Domain Association",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://amplify.{region}.amazonaws.com/apps/:appId/domains",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new domain association for an Amplify app."
