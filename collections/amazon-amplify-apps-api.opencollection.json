              },
              {
                "name": "nextToken",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of the existing Amplify apps."
        },
        {
          "info": {
            "name": "Amazon Amplify Create App",
            "type": "http"
          },
          "http": {
            "method": "POST",
