        {
          "info": {
            "name": "Amazon Amplify Create Branch",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://amplify.{region}.amazonaws.com/apps/:appId/branches",
            "params": [
              {
                "name": "appId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new branch for an Amplify app."
