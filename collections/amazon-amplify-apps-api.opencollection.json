              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing Amplify app."
        },
        {
          "info": {
            "name": "Amazon Amplify Delete App",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://amplify.{region}.amazonaws.com/apps/:appId",
